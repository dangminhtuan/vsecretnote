<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161B22"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#E6EDF3"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="⚡ Cài đặt Tốc ký (Word Macro)"
            android:textColor="#E6EDF3"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_reset_letter"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Mặc định"
            android:textSize="12sp"
            android:textColor="#F85149"
            style="@style/Widget.MaterialComponents.Button.TextButton" />
    </LinearLayout>

    <!-- Horizontal Alphabet Selector (A-Z) -->
    <HorizontalScrollView
        android:id="@+id/scroll_letters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:paddingVertical="8dp"
        android:paddingHorizontal="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container_letters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30363D" />

    <!-- Content Scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card: Thêm từ mới -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#30363D"
                app:cardBackgroundColor="#161B22">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_section_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thêm từ tốc ký cho chữ cái [ H ]"
                        android:textColor="#58A6FF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Input Cụm từ -->
                    <EditText
                        android:id="@+id/et_new_phrase"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/abc_edit_text_material"
                        android:hint="Nhập cụm từ (ví dụ: hôm nay, học tập...)"
                        android:textColorHint="#6E7681"
                        android:textColor="#E6EDF3"
                        android:textSize="14sp"
                        android:padding="8dp"
                        android:inputType="text" />

                    <!-- Preview thông minh 4 cấp độ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhãn phím tự sinh: "
                            android:textColor="#8B949E"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_preview_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="[--]"
                            android:textColor="#7EE787"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:background="#163326"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tv_preview_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cấp 1 (Từ đơn)"
                            android:textColor="#8B949E"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_add_macro"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="+ THÊM VÀO BÀN PHÍM"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:backgroundTint="#238636"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Danh sách từ hiện có -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#30363D"
                app:cardBackgroundColor="#161B22">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/tv_list_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Danh sách hiện có: 26 từ"
                            android:textColor="#E6EDF3"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_capacity_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dung lượng tối ưu: 25 - 36 từ"
                            android:textColor="#8B949E"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Container danh sách từ động -->
                    <LinearLayout
                        android:id="@+id/container_macro_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
