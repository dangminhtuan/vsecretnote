<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EFEFEF">

    <!-- Toolbar like Gboard -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="8dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/btn_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEXT MODE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/btn_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 NOTES"
            android:textSize="14sp"
            android:textColor="#333333"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="250dp">

        <!-- Custom View for Swipe Keyboard -->
        <vn.ehou.vsecretkeyboard.SwipeKeyboardView
            android:id="@+id/swipe_keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EFEFEF" />

        <!-- Notes Drawer Overlay -->
        <LinearLayout
            android:id="@+id/notes_drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:visibility="gone"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ghi chú (Notes)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:padding="12dp"
                android:background="#EEEEEE"/>
            
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_notes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
