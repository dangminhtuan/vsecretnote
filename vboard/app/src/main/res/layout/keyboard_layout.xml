<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#21262D">

    <!-- Toolbar trên cùng: Mode hiện tại & Nút ? HELP -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161B22"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/btn_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 0: Tiếng Việt gốc"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#58A6FF"
            android:background="#1F242C"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tv_layer_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tầng: Thường"
            android:textSize="12sp"
            android:textColor="#8B949E"/>

        <TextView
            android:id="@+id/btn_clipboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#58A6FF"
            android:background="#1F242C"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#C9D1D9"
            android:background="#1F242C"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_mic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#58A6FF"
            android:background="#1F242C"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Thanh Gợi Ý Từ (Suggestion Strip / Candidate Bar) -->
    <HorizontalScrollView
        android:id="@+id/suggestion_scroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#161B22"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/suggestion_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"/>
    </HorizontalScrollView>

    <!-- Thanh Thần Chú HUD (Guide Layer Mnemonic HUD Strip) -->
    <LinearLayout
        android:id="@+id/guide_hud_strip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#161B22"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_guide_hud_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📖 Chạm vào phím để học Thần chú 3 Vần &amp; Phụ âm"
            android:textSize="11.5sp"
            android:textColor="#C9D1D9"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"/>

        <TextView
            android:id="@+id/tv_guide_hud_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="💡 Nhấn giữ phím để mở Thẻ Thần Chú &amp; Câu chuyện liên tưởng"
            android:textSize="11.5sp"
            android:textColor="#C9D1D9"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="260dp">

        <!-- Bàn phím vẽ tùy biến 5 hàng -->
        <vn.ehou.vsecretkeyboard.SwipeKeyboardView
            android:id="@+id/swipe_keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1C2128" />

        <!-- Overlay Menu Chọn Chế Độ I/O (Chuẩn Gboard 2 thao tác) -->
        <LinearLayout
            android:id="@+id/iomode_menu_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#161B22"
            android:visibility="gone"
            android:elevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0D1117"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CHỌN CHẾ ĐỘ NHẬP / XUẤT (I/O MODE)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#58A6FF"/>

                <TextView
                    android:id="@+id/btn_close_iomode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕ Đóng"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#F85149"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <!-- Mode 1: VN -> VN -->
                    <LinearLayout
                        android:id="@+id/item_iomode_vn_vn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#21262D"
                        android:padding="8dp"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tv_title_vn_vn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇻🇳 VN ➔ VN (Tiếng Việt Tiêu Chuẩn)"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#58A6FF"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bật La bàn 6 hướng chọn dấu thanh siêu tốc (0ms)"
                                android:textSize="11sp"
                                android:textColor="#8B949E"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/check_iomode_vn_vn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#3FB950"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- Mode 2: B60 -> VN -->
                    <LinearLayout
                        android:id="@+id/item_iomode_b60_vn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#21262D"
                        android:padding="8dp"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tv_title_b60_vn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚡ B60 ➔ VN (Base60 sang Tiếng Việt)"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#79C0FF"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tắt la bàn dấu • Kích hoạt chế độ vuốt từ (Swipe)"
                                android:textSize="11sp"
                                android:textColor="#8B949E"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/check_iomode_b60_vn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#3FB950"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- Mode 3: VN -> B60 -->
                    <LinearLayout
                        android:id="@+id/item_iomode_vn_b60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#21262D"
                        android:padding="8dp"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tv_title_vn_b60"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔒 VN ➔ B60 (Tiếng Việt sang Base60)"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#D29922"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gõ chữ tự mã hóa ngược • Tắt la bàn, bật Swipe"
                                android:textSize="11sp"
                                android:textColor="#8B949E"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/check_iomode_vn_b60"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#3FB950"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- Mode 4: K.Dấu -> VN -->
                    <LinearLayout
                        android:id="@+id/item_iomode_kdau_vn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#21262D"
                        android:padding="8dp"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tv_title_kdau_vn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✍️ K.Dấu ➔ VN (Không Dấu sang Tiếng Việt)"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#FFA657"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gõ không dấu tự gắn dấu chuẩn • Bật Swipe"
                                android:textSize="11sp"
                                android:textColor="#8B949E"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/check_iomode_kdau_vn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#3FB950"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- Mode 5: B60 -> B60 -->
                    <LinearLayout
                        android:id="@+id/item_iomode_b60_b60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#21262D"
                        android:padding="8dp"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tv_title_b60_b60"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🛡️ B60 ➔ B60 (Mã Hóa Base60 Thuần)"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#BC8CFF"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gõ và giữ nguyên ký tự Base60 • Bật Swipe"
                                android:textSize="11sp"
                                android:textColor="#8B949E"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/check_iomode_b60_b60"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#3FB950"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Bảng Multi Clipboard Overlay 📋 (Giống Gboard) -->
        <LinearLayout
            android:id="@+id/clipboard_drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#0D1117"
            android:visibility="gone"
            android:elevation="6dp">

            <!-- Toolbar của Clipboard Drawer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#161B22"
                android:paddingHorizontal="10dp">

                <TextView
                    android:id="@+id/tv_clipboard_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📋 BỘ NHỚ TẠM"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#58A6FF"/>

                <TextView
                    android:id="@+id/btn_clear_clipboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗑️ Xóa chưa ghim"
                    android:textSize="11.5sp"
                    android:textColor="#8B949E"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="#21262D"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btn_close_clipboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕ Bàn phím"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#3FB950"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Nội dung danh sách Clipboard (ScrollView) -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/container_clipboard_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Dynamic clips rendered here -->

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Modal Card Thần Chú Toàn Diện 📖 (Mnemonic Cyber Card) -->
        <LinearLayout
            android:id="@+id/mnemonic_dialog_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#0D1117"
            android:visibility="gone"
            android:elevation="10dp">

            <!-- Toolbar của Mnemonic Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#161B22"
                android:paddingHorizontal="10dp">

                <TextView
                    android:id="@+id/tv_mnemonic_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📖 THẦN CHÚ BASE60"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#58A6FF"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/btn_close_mnemonic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕ Đóng"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#F85149"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Box Nhánh Thường -->
                    <LinearLayout
                        android:id="@+id/card_mnemonic_lower"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#161B22"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/tv_mnemonic_lower_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhánh Thường"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#3FB950"/>

                        <TextView
                            android:id="@+id/tv_mnemonic_lower_phrase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="thần chú..."
                            android:textSize="12sp"
                            android:textColor="#E6EDF3"
                            android:layout_marginTop="2dp"/>

                        <TextView
                            android:id="@+id/tv_mnemonic_lower_rhymes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="vần: ..."
                            android:textSize="11sp"
                            android:textColor="#E3B341"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Box Nhánh HOA -->
                    <LinearLayout
                        android:id="@+id/card_mnemonic_upper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#161B22"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/tv_mnemonic_upper_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhánh HOA (Shift)"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#58A6FF"/>

                        <TextView
                            android:id="@+id/tv_mnemonic_upper_phrase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="thần chú hoa..."
                            android:textSize="12sp"
                            android:textColor="#E6EDF3"
                            android:layout_marginTop="2dp"/>

                        <TextView
                            android:id="@+id/tv_mnemonic_upper_rhymes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="vần hoa: ..."
                            android:textSize="11sp"
                            android:textColor="#BC8CFF"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Box Câu chuyện liên tưởng (Story) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#21262D"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ Câu Chuyện Liên Tưởng (Gợi Nhớ)"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFA657"/>

                        <TextView
                            android:id="@+id/tv_mnemonic_story"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="câu chuyện..."
                            android:textSize="12sp"
                            android:textColor="#F0883E"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>

                    <!-- Box Từ mẫu Base60 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#161B22"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯 Từ Mẫu &amp; Mã Base60"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:textColor="#79C0FF"/>

                        <TextView
                            android:id="@+id/tv_mnemonic_samples"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="samples..."
                            android:textSize="11sp"
                            android:textColor="#8B949E"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
