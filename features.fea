@c3_p3_t = [b60_z.pos3_t b60_s.pos3_t b60_f.pos3_t b60_r.pos3_t b60_x.pos3_t b60_j.pos3_t b60_Z.pos3_t b60_S.pos3_t b60_F.pos3_t b60_R.pos3_t b60_X.pos3_t b60_J.pos3_t b60_a.pos3_t b60_e.pos3_t b60_i.pos3_t b60_u.pos3_t b60_w.pos3_t b60_y.pos3_t b60_0.pos3_t b60_1.pos3_t b60_2.pos3_t b60_3.pos3_t b60_4.pos3_t b60_5.pos3_t b60_6.pos3_t b60_7.pos3_t b60_8.pos3_t b60_9.pos3_t b60_B.pos3_t b60_C.pos3_t b60_A.pos3_t b60_E.pos3_t prefix_o.pos3_t b60_U.pos3_t b60_W.pos3_t b60_Y.pos3_t b60_c.pos3_t b60_d.pos3_t b60_g.pos3_t b60_G.pos3_t b60_k.pos3_t b60_K.pos3_t b60_h.pos3_t b60_v.pos3_t b60_D.pos3_t b60_m.pos3_t b60_n.pos3_t b60_b.pos3_t b60_l.pos3_t b60_Q.pos3_t b60_N.pos3_t b60_L.pos3_t b60_p.pos3_t b60_q.pos3_t b60_t.pos3_t b60_T.pos3_t b60_H.pos3_t b60_M.pos3_t b60_P.pos3_t b60_V.pos3_t];
@c3_p3_a = [b60_z.pos3_a b60_s.pos3_a b60_f.pos3_a b60_r.pos3_a b60_x.pos3_a b60_j.pos3_a b60_Z.pos3_a b60_S.pos3_a b60_F.pos3_a b60_R.pos3_a b60_X.pos3_a b60_J.pos3_a b60_a.pos3_a b60_e.pos3_a b60_i.pos3_a b60_u.pos3_a b60_w.pos3_a b60_y.pos3_a b60_0.pos3_a b60_1.pos3_a b60_2.pos3_a b60_3.pos3_a b60_4.pos3_a b60_5.pos3_a b60_6.pos3_a b60_7.pos3_a b60_8.pos3_a b60_9.pos3_a b60_B.pos3_a b60_C.pos3_a b60_A.pos3_a b60_E.pos3_a prefix_o.pos3_a b60_U.pos3_a b60_W.pos3_a b60_Y.pos3_a b60_c.pos3_a b60_d.pos3_a b60_g.pos3_a b60_G.pos3_a b60_k.pos3_a b60_K.pos3_a b60_h.pos3_a b60_v.pos3_a b60_D.pos3_a b60_m.pos3_a b60_n.pos3_a b60_b.pos3_a b60_l.pos3_a b60_Q.pos3_a b60_N.pos3_a b60_L.pos3_a b60_p.pos3_a b60_q.pos3_a b60_t.pos3_a b60_T.pos3_a b60_H.pos3_a b60_M.pos3_a b60_P.pos3_a b60_V.pos3_a];

feature calt {
    # 1. Chữ Hoa đầu từ (Tiền tố 'I' hoặc 'o') -> 1 viền đứng bên trái
    sub prefix_I @c1' @c2 @c3 by @c1_p1;
    sub prefix_I @c1_p1 @c2' @c3 by @c2_p2;
    sub prefix_I @c1_p1 @c2_p2 @c3' by @c3_p3_t;

    sub prefix_o @c1' @c2 @c3 by @c1_p1;
    sub prefix_o @c1_p1 @c2' @c3 by @c2_p2;
    sub prefix_o @c1_p1 @c2_p2 @c3' by @c3_p3_t;

    # 2. CHỮ HOA TOÀN TỪ (Tiền tố 'O') -> Khung viền 4 xung quanh
    sub prefix_O @c1' @c2 @c3 by @c1_p1;
    sub prefix_O @c1_p1 @c2' @c3 by @c2_p2;
    sub prefix_O @c1_p1 @c2_p2 @c3' by @c3_p3_a;

    # 3. Chữ thường tiêu chuẩn (Không tiền tố) -> Không viền
    sub @c1' @c2 @c3 by @c1_p1;
    sub @c1_p1 @c2' @c3 by @c2_p2;
    sub @c1_p1 @c2_p2 @c3' by @c3_p3;
} calt;
