languagesystem DFLT dflt;
languagesystem latn dflt;

@c1 = [b60_c b60_d b60_g b60_G b60_j b60_k b60_K b60_h b60_v b60_D b60_m b60_C b60_r b60_s b60_n b60_b b60_l b60_Q b60_S b60_z b60_N b60_y b60_L b60_W b60_p b60_f b60_q b60_t b60_T b60_R b60_x];
