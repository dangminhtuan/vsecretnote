@c3_p3_top = [b60_z.pos3_top b60_s.pos3_top b60_f.pos3_top b60_r.pos3_top b60_x.pos3_top b60_j.pos3_top b60_a.pos3_top b60_e.pos3_top b60_i.pos3_top b60_u.pos3_top b60_w.pos3_top b60_y.pos3_top b60_0.pos3_top b60_1.pos3_top b60_2.pos3_top b60_3.pos3_top b60_4.pos3_top b60_5.pos3_top b60_6.pos3_top b60_7.pos3_top b60_8.pos3_top b60_9.pos3_top b60_o.pos3_top b60_c.pos3_top b60_d.pos3_top b60_g.pos3_top b60_k.pos3_top b60_h.pos3_top b60_v.pos3_top b60_m.pos3_top b60_n.pos3_top b60_b.pos3_top b60_l.pos3_top b60_p.pos3_top b60_q.pos3_top b60_t.pos3_top];
