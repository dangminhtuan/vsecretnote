      },
      '3': {
        left: { rhyme: '2', word: '3' },
        right: { rhyme: '4', word: '3' },
        bottom_left: { rhyme: '-w', word: 'w' },
        bottom: { rhyme: '-e', word: 'e' },
        bottom_right: { rhyme: '-r', word: 'r' }
      },
      '4': {
        left: { rhyme: '3', word: '4' },
        right: { rhyme: '5', word: '4' },
        bottom_left: { rhyme: '-e', word: 'e' },
        bottom: { rhyme: '-r', word: 'r' },
        bottom_right: { rhyme: '-t', word: 't' }
      },
      '5': {
        left: { rhyme: '4', word: '5' },
        right: { rhyme: '6', word: '5' },
        bottom_left: { rhyme: '-r', word: 'r' },
        bottom: { rhyme: '-t', word: 't' },
        bottom_right: { rhyme: '-y', word: 'y' }
      }
    };

    // 4. DANH SÁCH TỪ ĐIỂN VÍ DỤ GHÉP VẦN
    const SAMPLE_WORDS = {
      'ương': 'sướng', 'oan': 'toán', 'êu': 'kêu', 'yêu': 'yêu', 'iên': 'tiền',
      'iêt': 'chi tiết', 'ưa': 'mưa', 'ư': 'từ', 'a': 'cá', 'e': 'xe', 'i': 'đi',
      'o': 'bò', 'u': 'bú', 'an': 'bàn', 'ang': 'sáng', 'anh': 'xanh', 'ơi': 'chơi',
      'ôi': 'tôi', 'am': 'cam', 'at': 'hát', 'ay': 'tay', 'ao': 'sao', 'au': 'tàu',
      'ươn': 'vươn', 'ươc': 'nước', 'ươi': 'tươi', 'ưng': 'rừng', 'ưu': 'lưu',
      'ươu': 'rượu', 'uy': 'quy', 'uyên': 'khuyên', 'uyêt': 'quyết', 'oa': 'hoa'
    };

    // ========================================================
    // XÂY DỰNG DATA 169 VẦN TOÀN DIỆN
    // ========================================================
    const ALL_169_RHYMES = [];
    const KEYBOARD_ASSIGNMENT_MAP = new Map(); // rhymeClean -> Array<{ key, dir, word }>

    // Quét toàn bộ KEY_NEIGHBORS để tìm vị trí vần trên bàn phím
    Object.entries(KEY_NEIGHBORS).forEach(([key, dirs]) => {
      Object.entries(dirs).forEach(([dir, item]) => {
        if (item && item.rhyme && item.rhyme.startsWith('-')) {
          const clean = item.rhyme.replace(/^-/, '').toLowerCase();
          if (!KEYBOARD_ASSIGNMENT_MAP.has(clean)) {
            KEYBOARD_ASSIGNMENT_MAP.set(clean, []);
          }
          KEYBOARD_ASSIGNMENT_MAP.get(clean).push({
            key,
            dir,
            word: item.word || clean
          });
        }
      });
    });

    let sttCounter = 1;
    function registerTable(rhymeArray, tableNum, tableName, badgeClass) {
      rhymeArray.forEach((r, idx) => {
        if (r && r !== '-' && r !== 'null') {
          const b60 = BASE60_MAPPING[idx];
          const isUpper = /^[A-Z]$/.test(b60);
          const assignments = KEYBOARD_ASSIGNMENT_MAP.get(r) || [];
          
          ALL_169_RHYMES.push({
            stt: sttCounter++,
            rhyme: r,
            tableNum,
            tableName,
            badgeClass,
            mm: idx,
            b60,
            isUpper,
            assignments,
            sample: SAMPLE_WORDS[r] || (r.length === 1 ? 't' + r : 'to' + r)
          });
        }
      });
    }

    registerTable(RHYMES_BASE, 1, 'B1 (Telex)', 'badge-b1');
    registerTable(RHYMES_EXTRA_1, 2, 'B2 (yaeiou)', 'badge-b2');
    registerTable(RHYMES_EXTRA_2, 3, 'B3 (Số VNI)', 'badge-b3');

    // Thống kê metrics
    const totalRhymes = ALL_169_RHYMES.length;
    const coveredRhymes = ALL_169_RHYMES.filter(r => r.assignments.length > 0).length;
    const missingRhymes = totalRhymes - coveredRhymes;
    const percentCovered = ((coveredRhymes / totalRhymes) * 100).toFixed(1);

    document.getElementById('cardTotalRhymes').textContent = totalRhymes;
    document.getElementById('cardCoveredRhymes').textContent = coveredRhymes;
    document.getElementById('cardCoveredPercent').textContent = `${percentCovered}% độ phủ bàn phím`;
    document.getElementById('cardMissingRhymes').textContent = missingRhymes;
    document.getElementById('unassignedCountBadge').textContent = missingRhymes;

    // ========================================================
    // STATE & CONTROLS
    // ========================================================
    let currentTab = 'keys'; // 'keys' | 'rhymes' | 'unassigned'
    let currentFilter = 'all';
    let searchQuery = '';

    const contentContainer = document.getElementById('contentContainer');
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortSelect');

    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      renderActiveView();
    });

    window.switchTab = function(tabName) {
      currentTab = tabName;
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      if (tabName === 'keys') document.getElementById('tabBtnKeys').classList.add('active');
      else if (tabName === 'rhymes') document.getElementById('tabBtnRhymes').classList.add('active');
      else if (tabName === 'unassigned') document.getElementById('tabBtnUnassigned').classList.add('active');
      renderActiveView();
    };

    window.setFilter = function(filterVal) {
      currentFilter = filterVal;
      document.querySelectorAll('.filter-chip').forEach(c => {
        c.classList.toggle('active', c.dataset.filter === filterVal);
      });
      renderActiveView();
    };

    window.renderActiveView = function() {
      if (currentTab === 'keys') renderKeysView();
      else if (currentTab === 'rhymes') renderRhymesView();
      else if (currentTab === 'unassigned') renderUnassignedView();
    };

    // ========================================================
    // TAB 1: BẢNG PHÍM (KEY-BY-KEY MATRIX)
    // ========================================================
    function renderKeysView() {
      // Danh sách các phím chữ và số cần soi
      const keysList = Object.keys(KEY_NEIGHBORS);

      let filteredKeys = keysList.filter(k => {
        const item = KEY_NEIGHBORS[k];
        const toneInfo = TONE_KEYS[k];
        const cluster = Object.values(CONS_CLUSTERS).find(c => c.key === k);

        // Lọc theo search
        if (searchQuery) {
          const matchKey = k.toLowerCase().includes(searchQuery);
          const matchCluster = cluster && cluster.name.toLowerCase().includes(searchQuery);
          const matchTone = toneInfo && (toneInfo.name.toLowerCase().includes(searchQuery) || toneInfo.table.toLowerCase().includes(searchQuery));
          const matchDirs = Object.values(item).some(d => d.rhyme && d.rhyme.toLowerCase().includes(searchQuery));
          if (!matchKey && !matchCluster && !matchTone && !matchDirs) return false;
        }

        // Lọc theo filter chip
        if (currentFilter === 'b1' && (!toneInfo || !toneInfo.table.includes('B1'))) return false;
        if (currentFilter === 'b2' && (!toneInfo || !toneInfo.table.includes('B2'))) return false;
        if (currentFilter === 'b3' && (!toneInfo || !toneInfo.table.includes('B3'))) return false;
        return true;
      });

      let html = `
        <div class="table-responsive">
          <table class="audit-table">
            <thead>
              <tr>
                <th style="width: 50px;">Phím</th>
                <th>Phụ Âm Gốc / Mở Rộng</th>
                <th>Chức Năng Dấu Thanh</th>
                <th>Vần Cốt Lõi (Base60)</th>
                <th>8 Hướng Vuốt Chi Tiết</th>
                <th>Ví Dụ Ghép Từ</th>
              </tr>
            </thead>
            <tbody>
      `;

      filteredKeys.forEach(k => {
        const item = KEY_NEIGHBORS[k];
        const toneInfo = TONE_KEYS[k];
        const cluster = Object.values(CONS_CLUSTERS).find(c => c.key === k);

        // Phụ âm
        let consHtml = `<span style="color:#8b949e;">--</span>`;
        if (cluster) {
          consHtml = `<span class="badge-cons">${cluster.name}</span> <span style="font-size:11px; color:#8b949e;">(Base60: <strong>${cluster.b60}</strong>)</span>`;
        } else if (/^[bcdđghklmnpqrstvx]$/i.test(k)) {
          consHtml = `<span style="font-weight:700;">${k}</span>`;
        }

        // Dấu thanh
        let toneHtml = `<span style="color:#8b949e;">--</span>`;
        if (toneInfo) {
          const bClass = toneInfo.table.includes('B1') ? 'badge-b1' : toneInfo.table.includes('B2') ? 'badge-b2' : 'badge-b3';
          toneHtml = `<span class="${bClass}">Dấu ${toneInfo.name}</span> <span style="font-size:11px; color:#8b949e;">(${toneInfo.table})</span>`;
        }

        // Vần cốt lõi
        let coreRimeHtml = `<span style="color:#8b949e;">--</span>`;
        if (k === 's') coreRimeHtml = `<span class="badge-b1">-ương</span> <span class="badge-b2">-oan</span>`;
        else if (k === 'w') coreRimeHtml = `<span class="badge-b1">-ư</span>`;
        else if (k === 'y') coreRimeHtml = `<span class="badge-b1" style="font-style:italic;">-YÊU</span>`;
        else if (k === 'e') coreRimeHtml = `<span class="badge-b1" style="font-style:italic;">-ÊU</span>`;
        else if (k === 'a') coreRimeHtml = `<span class="badge-b1">-a</span>`;
        else if (k === 'o') coreRimeHtml = `<span class="badge-b1">-o</span>`;
        else if (k === 'u') coreRimeHtml = `<span class="badge-b1">-u</span>`;
        else if (k === 'i') coreRimeHtml = `<span class="badge-b1">-i</span>`;

        // 8 hướng vuốt
        const dirs = [
          { code: 'top_left', label: '↖ TL' },
          { code: 'top', label: '↑ T' },
          { code: 'top_right', label: '↗ TR' },
          { code: 'left', label: '← L' },
          { code: 'right', label: '→ R' },
          { code: 'bottom_left', label: '↙ BL' },
          { code: 'bottom', label: '↓ B' },
          { code: 'bottom_right', label: '↘ BR' }
        ];

        let compassHtml = `<div class="mini-compass">`;
        dirs.forEach((d, i) => {
          if (i === 4) {
            compassHtml += `<div class="mc-cell mc-center">${k.toUpperCase()}</div>`;
          }
          const val = item[d.code] ? item[d.code].rhyme : '-';
          compassHtml += `<div class="mc-cell" title="${d.label}: ${val}">${val}</div>`;
        });
        compassHtml += `</div>`;

        // Ví dụ
        let sample = '--';
        if (k === 's') sample = `<code>sướng [sss]</code>, <code>sa</code>, <code>sư</code>`;
        else if (k === 't') sample = `<code>tiết</code>, <code>toán</code>, <code>tay</code>, <code>Th</code>`;
        else if (k === 'r') sample = `<code>ra</code>, <code>ri</code>, <code>Tr</code>`;
        else if (k === 'w') sample = `<code>rượu</code>, <code>hương</code>, <code>vươn</code>`;
        else if (k === 'c') sample = `<code>cao</code>, <code>con</code>, <code>Ch</code>`;

        html += `
          <tr>
            <td><strong style="font-size:16px; font-family:var(--font-mono); color:#fff;">${k}</strong></td>
            <td>${consHtml}</td>
            <td>${toneHtml}</td>
            <td>${coreRimeHtml}</td>
            <td>${compassHtml}</td>
            <td style="font-size:11.5px; color:#c9d1d9;">${sample}</td>
          </tr>
        `;
      });

      html += `</tbody></table></div>`;
      contentContainer.innerHTML = html;
    }

    // ========================================================
    // TAB 2: BẢNG 169 VẦN CHUẨN (13² REGISTRY)
    // ========================================================
    function renderRhymesView() {
      let filtered = ALL_169_RHYMES.filter(r => {
        // Lọc theo search
        if (searchQuery) {
          const matchRhyme = r.rhyme.toLowerCase().includes(searchQuery);
          const matchB60 = r.b60.toLowerCase().includes(searchQuery);
          const matchTable = r.tableName.toLowerCase().includes(searchQuery);
          const matchAssigned = r.assignments.some(a => a.key.toLowerCase().includes(searchQuery));
          if (!matchRhyme && !matchB60 && !matchTable && !matchAssigned) return false;
        }

        // Lọc theo filter chip
        if (currentFilter === 'b1' && r.tableNum !== 1) return false;
        if (currentFilter === 'b2' && r.tableNum !== 2) return false;
        if (currentFilter === 'b3' && r.tableNum !== 3) return false;
        if (currentFilter === 'assigned' && r.assignments.length === 0) return false;
        if (currentFilter === 'unassigned' && r.assignments.length > 0) return false;
        return true;
      });

      // Sắp xếp
      const sortVal = sortSelect.value;
      if (sortVal === 'name_asc') {
        filtered.sort((a, b) => a.rhyme.localeCompare(b.rhyme));
      } else if (sortVal === 'table_asc') {
        filtered.sort((a, b) => a.tableNum - b.tableNum || a.mm - b.mm);
      } else if (sortVal === 'status') {
        filtered.sort((a, b) => b.assignments.length - a.assignments.length);
      } else {
        filtered.sort((a, b) => a.stt - b.stt);
      }

      let html = `
        <div class="table-responsive">
          <table class="audit-table">
            <thead>
              <tr>
                <th style="width: 45px;">STT</th>
                <th>Vần Tiếng Việt</th>
                <th>Bảng VComp</th>
                <th>Chỉ Số MM</th>
                <th>Mã Base60</th>
                <th>Kiểu Chữ Viết Tay</th>
                <th>Trạng Thái Trên Bàn Phím</th>
                <th>Từ Ví Dụ</th>
              </tr>
            </thead>
            <tbody>
      `;

      filtered.forEach(r => {
        let assignHtml = '';
        if (r.assignments.length > 0) {
          const keysStr = r.assignments.map(a => `<strong>${a.key}</strong> (${a.dir})`).join(', ');
          assignHtml = `<span class="badge-assigned">✅ Tại phím ${keysStr}</span>`;
        } else {
          assignHtml = `<span class="badge-unassigned">⚠️ Chưa gán</span>`;
        }

        const caseHtml = r.isUpper ? `<span style="color:var(--glow-b2); font-weight:700; font-style:italic;">IN HOA (${r.b60})</span>` : `<span style="color:var(--text-muted);">Thường (${r.b60})</span>`;

        html += `
          <tr>
            <td style="color:#8b949e; font-family:var(--font-mono); font-size:11px;">#${r.stt}</td>
            <td><strong style="font-size:15px; color:#fff;">-${r.rhyme}</strong></td>
            <td><span class="${r.badgeClass}">${r.tableName}</span></td>
            <td style="font-family:var(--font-mono); color:#8b949e;">MM=${r.mm}</td>
            <td><span class="b60-glyph ${r.isUpper ? 'is-upper' : ''}">${r.b60}</span></td>
            <td>${caseHtml}</td>
            <td>${assignHtml}</td>
            <td style="font-size:12px; color:#c9d1d9;">${r.sample}</td>
          </tr>
        `;
      });

      html += `</tbody></table></div>`;
      contentContainer.innerHTML = html;
    }

    // ========================================================
    // TAB 3: KHO VẦN CHƯA GÁN (UNASSIGNED RHYMES POOL)
    // ========================================================
    function renderUnassignedView() {
      let missingList = ALL_169_RHYMES.filter(r => r.assignments.length === 0);

      if (searchQuery) {
        missingList = missingList.filter(r => r.rhyme.toLowerCase().includes(searchQuery) || r.b60.toLowerCase().includes(searchQuery));
      }
      if (currentFilter === 'b1') missingList = missingList.filter(r => r.tableNum === 1);
      if (currentFilter === 'b2') missingList = missingList.filter(r => r.tableNum === 2);
      if (currentFilter === 'b3') missingList = missingList.filter(r => r.tableNum === 3);

      let html = `
        <div style="padding: 14px 16px; border-bottom: 1px solid var(--border-dark); font-size: 13px; color: var(--text-muted); display:flex; justify-content:space-between; align-items:center;">
          <span>Danh sách <strong>${missingList.length} vần</strong> chưa được bố trí vào 8 hướng của bất kỳ phím nào trên bàn phím lưới:</span>
          <span class="badge-unassigned">${missingList.length} vần còn trống</span>
        </div>
        <div class="unassigned-grid">
      `;

      missingList.forEach(r => {
        html += `
          <div class="unassigned-card">
            <div class="unassigned-rhyme">-${r.rhyme}</div>
            <div class="unassigned-meta">
              <span class="${r.badgeClass}">${r.tableNum === 1 ? 'B1' : r.tableNum === 2 ? 'B2' : 'B3'}</span>
              <span class="b60-glyph ${r.isUpper ? 'is-upper' : ''}">${r.b60}</span>
            </div>
          </div>
        `;
      });

      html += `</div>`;
      contentContainer.innerHTML = html;
    }

    // Khởi tạo hiển thị
    renderActiveView();
  </script>
</body>
</html>
