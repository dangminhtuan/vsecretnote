<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bảng Kiểm Toán & Thống Kê 169 Vần (13²) & Phím VComp</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-body: #0d1117;
      --bg-card: #161b22;
      --bg-card-hover: #1f242c;
      --bg-header: #0f141c;
      --bg-key: #21262d;
      --border-dark: #30363d;
      --border-focus: #58a6ff;

      /* Mã Màu Học Tập VComp Chuẩn */
      --glow-b1: #58a6ff;     /* Bảng 1: Dấu Telex zfsrxj */
      --glow-b2: #f2cc60;     /* Bảng 2: Dấu yaeiou */
      --glow-b3: #3fb950;     /* Bảng 3: Dấu VNI 012345 */
      --glow-cons: #bc8cff;   /* Phụ âm ghép: th, ch, nh, ng... */
      --glow-cyan: #58a6ff;
      --glow-red: #f85149;

      --text-main: #f0f6fc;
      --text-muted: #8b949e;
      --text-sub: #7ee787;

      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'Fira Code', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg-body);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      padding: 16px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .container {
      width: 100%;
      max-width: 1200px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* Header Bar */
    .header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--bg-header);
      padding: 14px 20px;
      border: 1px solid var(--border-dark);
      border-radius: 12px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .title-group h1 {
      font-size: 18px;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: -0.3px;
    }

    .title-group p {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 3px;
    }

    .badge-top {
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 12px;
      background: rgba(88, 166, 255, 0.15);
      color: var(--glow-b1);
      border: 1px solid rgba(88, 166, 255, 0.3);
      font-family: var(--font-mono);
      font-weight: 700;
    }

    .btn-link-sim {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #1f6feb;
      color: #fff;
      text-decoration: none;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 12.5px;
      font-weight: 700;
      transition: all 0.15s;
      border: 1px solid #388bfd;
    }
    .btn-link-sim:hover {
      background: #388bfd;
      box-shadow: 0 0 12px rgba(56, 139, 253, 0.5);
    }
    .btn-link-ip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(63, 185, 80, 0.12);
      color: #7ee787;
      text-decoration: none;
      padding: 8px 14px;
      border-radius: 8px;
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 12px;
      border: 1px solid rgba(63, 185, 80, 0.35);
      transition: all 0.15s;
    }
    .btn-link-ip:hover {
      background: rgba(63, 185, 80, 0.25);
      border-color: #3fb950;
      box-shadow: 0 0 10px rgba(63, 185, 80, 0.3);
    }

    /* Dashboard Metrics Cards (5 Cards) */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
    }

    .metric-card {
      background: var(--bg-card);
      border: 1px solid var(--border-dark);
      border-radius: 10px;
      padding: 12px 16px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      position: relative;
      overflow: hidden;
    }

    .metric-card::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: var(--glow-cyan);
    }
    .metric-card.b1::before { background: var(--glow-b1); }
    .metric-card.b2::before { background: var(--glow-b2); }
    .metric-card.b3::before { background: var(--glow-b3); }
    .metric-card.cons::before { background: var(--glow-cons); }
    .metric-card.unassigned::before { background: var(--glow-red); }

    .metric-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
    }

    .metric-value {
      font-size: 24px;
      font-weight: 800;
      font-family: var(--font-mono);
      color: #fff;
    }

    .metric-sub {
      font-size: 11px;
      color: var(--text-muted);
    }

    /* Controls: Search, Tabs, Filters */
    .control-panel {
      background: var(--bg-card);
      border: 1px solid var(--border-dark);
      border-radius: 12px;
      padding: 14px 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .tabs-row {
      display: flex;
      gap: 8px;
      border-bottom: 1px solid var(--border-dark);
      padding-bottom: 10px;
      overflow-x: auto;
    }

    .tab-btn {
      background: var(--bg-key);
      border: 1px solid var(--border-dark);
      color: var(--text-muted);
      padding: 7px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.15s;
      white-space: nowrap;
    }
    .tab-btn:hover {
      background: #30363d;
      color: #fff;
    }
    .tab-btn.active {
      background: #1f6feb;
      border-color: #58a6ff;
      color: #fff;
      box-shadow: 0 0 10px rgba(88, 166, 255, 0.4);
    }

    .filters-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .search-box {
      flex: 1;
      min-width: 250px;
      position: relative;
    }
    .search-input {
      width: 100%;
      background: #0f141c;
      border: 1px solid var(--border-dark);
      border-radius: 8px;
      padding: 8px 12px 8px 34px;
      font-size: 13px;
      color: #fff;
      font-family: var(--font-sans);
      outline: none;
      transition: border 0.15s;
    }
    .search-input:focus {
      border-color: var(--border-focus);
    }
    .search-icon {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 13px;
      color: var(--text-muted);
      pointer-events: none;
    }

    .filter-chips {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .filter-chip {
      background: var(--bg-key);
      border: 1px solid var(--border-dark);
      color: var(--text-muted);
      font-size: 11.5px;
      font-weight: 600;
      padding: 5px 10px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .filter-chip:hover {
      background: #30363d;
      color: #fff;
    }
    .filter-chip.active {
      background: #238636;
      border-color: #3fb950;
      color: #fff;
    }

    /* Sort Select */
    .sort-group {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--text-muted);
    }
    .sort-select {
      background: #0f141c;
      border: 1px solid var(--border-dark);
      color: #fff;
      padding: 5px 10px;
      border-radius: 6px;
      font-size: 12px;
      outline: none;
      font-weight: 600;
    }

    /* Table Card */
    .content-card {
      background: var(--bg-card);
      border: 1px solid var(--border-dark);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }

    .table-responsive {
      width: 100%;
      overflow-x: auto;
    }

    table.audit-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12.5px;
      text-align: left;
    }

    table.audit-table th {
      background: #141c28;
      padding: 10px 14px;
      font-weight: 700;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      border-bottom: 2px solid var(--border-dark);
      white-space: nowrap;
    }

    table.audit-table td {
      padding: 9px 14px;
      border-bottom: 1px solid #21262d;
      vertical-align: middle;
    }

    table.audit-table tbody tr:hover {
      background: rgba(255, 255, 255, 0.03);
    }

    /* Badges & Tags */
    .badge-b1 {
      display: inline-block;
      font-size: 11px;
      padding: 2px 7px;
      border-radius: 4px;
      background: rgba(88, 166, 255, 0.15);
      color: var(--glow-b1);
      border: 1px solid rgba(88, 166, 255, 0.35);
      font-family: var(--font-mono);
      font-weight: 600;
    }
    .badge-b2 {
      display: inline-block;
      font-size: 11px;
      padding: 2px 7px;
      border-radius: 4px;
      background: rgba(242, 204, 96, 0.15);
      color: var(--glow-b2);
      border: 1px solid rgba(242, 204, 96, 0.35);
      font-family: var(--font-mono);
      font-weight: 600;
    }
    .badge-b3 {
      display: inline-block;
      font-size: 11px;
      padding: 2px 7px;
      border-radius: 4px;
      background: rgba(63, 185, 80, 0.15);
      color: var(--glow-b3);
      border: 1px solid rgba(63, 185, 80, 0.35);
      font-family: var(--font-mono);
      font-weight: 600;
    }
    .badge-cons {
      display: inline-block;
      font-size: 11px;
      padding: 2px 7px;
      border-radius: 4px;
      background: rgba(188, 140, 255, 0.15);
      color: var(--glow-cons);
      border: 1px solid rgba(188, 140, 255, 0.35);
      font-family: var(--font-mono);
      font-weight: 700;
    }
    .badge-unassigned {
      display: inline-block;
      font-size: 10.5px;
      padding: 2px 7px;
      border-radius: 4px;
      background: rgba(248, 81, 73, 0.12);
      color: var(--glow-red);
      border: 1px solid rgba(248, 81, 73, 0.3);
      font-weight: 600;
    }
    .badge-assigned {
      display: inline-block;
      font-size: 10.5px;
      padding: 2px 7px;
      border-radius: 4px;
      background: rgba(63, 185, 80, 0.12);
      color: var(--glow-b3);
      border: 1px solid rgba(63, 185, 80, 0.3);
      font-weight: 600;
    }

    /* Base60 typography */
    .b60-glyph {
      font-family: var(--font-mono);
      font-size: 13px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      background: #0f141c;
      border: 1px solid var(--border-dark);
      display: inline-block;
    }
    .b60-glyph.is-upper {
      color: #fff;
      font-style: italic;
      border-color: var(--glow-b2);
      text-decoration: underline dotted;
    }

    /* Mini Compass 3x3 for keys */
    .mini-compass {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 3px;
      max-width: 220px;
      background: #0f141c;
      padding: 5px;
      border-radius: 6px;
      border: 1px solid var(--border-dark);
    }
    .mc-cell {
      text-align: center;
      font-size: 10px;
      font-family: var(--font-mono);
      padding: 2px;
      border-radius: 3px;
      background: #161b22;
      color: var(--text-muted);
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .mc-center {
      background: #1f6feb;
      color: #fff;
      font-weight: 700;
      font-size: 11.5px;
    }

    /* Unassigned Rhymes Grid */
    .unassigned-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 10px;
      padding: 16px;
    }
    .unassigned-card {
      background: #0f141c;
      border: 1px solid var(--border-dark);
      border-radius: 8px;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      transition: all 0.15s;
    }
    .unassigned-card:hover {
      border-color: var(--glow-b1);
      transform: translateY(-2px);
    }
    .unassigned-rhyme {
      font-size: 15px;
      font-weight: 700;
      color: #fff;
    }
    .unassigned-meta {
      font-size: 10.5px;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
    }

    /* Footer info */
    .footer-bar {
      text-align: center;
      font-size: 12px;
      color: var(--text-muted);
      padding: 10px 0;
      line-height: 1.5;
    }

    @media (max-width: 768px) {
      body { padding: 8px; }
      .header-bar { flex-direction: column; align-items: flex-start; }
      .metrics-grid { grid-template-columns: 1fr 1fr; }
      .filters-row { flex-direction: column; align-items: stretch; }
      .search-box { width: 100%; }
    }
  </style>
</head>
<body>

  <div class="container">
    
    <!-- Top Header Bar -->
    <div class="header-bar">
      <div class="title-group">
        <h1>
          <span>📊 VComp Audit & Atlas</span>
          <span class="badge-top">169 VẦN (13²)</span>
        </h1>
        <p>Kiểm toán & đối chiếu toàn diện: Phím nào ➔ Phụ âm gì ➔ Dấu gì ➔ Vần gì ➔ Độ phủ Base60</p>
      </div>
      <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
        <a href="http://192.168.1.124:5173/keyboard-grid.html" class="btn-link-ip" title="Mở trực tiếp qua Mobile IP trên điện thoại">📱 Mobile IP: 192.168.1.124:5173</a>
        <a href="keyboard-grid.html" class="btn-link-sim">⌨️ Bàn Phím Lưới Gõ Thử ➔</a>
      </div>
    </div>

    <!-- Metrics Cards Row (5 Cards) -->
    <div class="metrics-grid">
      <div class="metric-card b1">
        <span class="metric-label">Chuẩn VComp 13²</span>
        <span class="metric-value" id="cardTotalRhymes">169</span>
        <span class="metric-sub">57 B1 | 56 B2 | 56 B3</span>
      </div>
      <div class="metric-card b3">
        <span class="metric-label">Độ Phủ Bàn Phím</span>
        <span class="metric-value" id="cardCoveredRhymes">--</span>
        <span class="metric-sub" id="cardCoveredPercent">Đang tính...</span>
      </div>
      <div class="metric-card unassigned">
        <span class="metric-label">Vần Chưa Gán</span>
        <span class="metric-value" id="cardMissingRhymes">--</span>
        <span class="metric-sub">Cần bổ sung vào phím trống</span>
      </div>
      <div class="metric-card b2">
        <span class="metric-label">18 Phím Dấu</span>
        <span class="metric-value">18 phím</span>
        <span class="metric-sub">B1: zfsrxj | B2: yaeiou | B3: 0..5</span>
      </div>
      <div class="metric-card cons">
        <span class="metric-label">Phụ Âm Ghép</span>
        <span class="metric-value">11 cụm</span>
        <span class="metric-sub">Th, Tr, Ch, Kh, Gh, Ng, Nh, Ph, Qu...</span>
      </div>
    </div>

    <!-- Control Panel (Tabs, Search, Filters, Sort) -->
    <div class="control-panel">
      <!-- Tabs Row -->
      <div class="tabs-row">
        <button class="tab-btn active" id="tabBtnKeys" onclick="switchTab('keys')">
          <span>⌨️ Bảng Phím (Key-by-Key Matrix)</span>
        </button>
        <button class="tab-btn" id="tabBtnRhymes" onclick="switchTab('rhymes')">
          <span>📚 169 Vần Chuẩn (13² Registry)</span>
        </button>
        <button class="tab-btn" id="tabBtnUnassigned" onclick="switchTab('unassigned')">
          <span>🧩 Kho Vần Chưa Gán (<span id="unassignedCountBadge">--</span>)</span>
        </button>
      </div>

      <!-- Filters & Search Row -->
      <div class="filters-row">
        <div class="search-box">
          <span class="search-icon">🔍</span>
          <input type="text" id="searchInput" class="search-input" placeholder="Tìm theo phím, vần (-ương, -oan), phụ âm (Th, Tr), mã Base60...">
        </div>

        <div class="filter-chips">
          <button class="filter-chip active" data-filter="all" onclick="setFilter('all')">Tất Cả</button>
          <button class="filter-chip" data-filter="b1" onclick="setFilter('b1')">🔵 Bảng 1 (Telex)</button>
          <button class="filter-chip" data-filter="b2" onclick="setFilter('b2')">🟡 Bảng 2 (yaeiou)</button>
          <button class="filter-chip" data-filter="b3" onclick="setFilter('b3')">🟢 Bảng 3 (Số VNI)</button>
          <button class="filter-chip" data-filter="assigned" onclick="setFilter('assigned')">✅ Đã Gán</button>
          <button class="filter-chip" data-filter="unassigned" onclick="setFilter('unassigned')">⚠️ Chưa Gán</button>
        </div>

        <div class="sort-group">
          <span>Sắp xếp:</span>
          <select id="sortSelect" class="sort-select" onchange="renderActiveView()">
            <option value="stt">Theo STT VComp (1 ➔ 169)</option>
            <option value="name_asc">Theo Vần (A ➔ Z)</option>
            <option value="table_asc">Theo Bảng (B1 ➔ B2 ➔ B3)</option>
            <option value="status">Đã gán lên phím trước</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Dynamic Content Area -->
    <div class="content-card" id="contentContainer">
      <!-- Injected by JavaScript -->
    </div>

    <!-- Footer Information -->
    <div class="footer-bar">
      ✨ <strong>VComp 13² Architecture:</strong> Mỗi âm tiết tiếng Việt được cấu tạo bởi <code>[Phụ âm đầu] + [Vần] + [Dấu thanh]</code> tương ứng mã Base60 <code>[HH][MM][SS]</code>.<br>
      Quy tắc vàng: <code>s</code> (phụ âm) + <code>-ương</code> (vần B1 mã s) + <code>dấu sắc</code> (B1 mã s) = <strong>sss ➔ "sướng"</strong> | <code>t</code> + <code>Th</code> (mã T hoa) | <code>r</code> + <code>Tr</code> (mã R hoa).
    </div>

  </div>

  <script type="module">
    import {
      RHYMES_BASE, RHYMES_EXTRA_1, RHYMES_EXTRA_2,
      BASE60_MAPPING, CONSONANTS_BASE, CONSONANTS_EXTRA
    } from './data.js';

    import {
      encodeWord, decodeWord, timeToBase60, base60ToTime,
      TONE_TABLE_B1, TONE_TABLE_B2, TONE_TABLE_B3
    } from './vcomp.js';

    // 1. DATA 18 PHÍM DẤU CHUẨN
    const TONE_KEYS = {
      'z': { table: 'B1 (Telex)', tone: 0, name: 'Bằng' },
      's': { table: 'B1 (Telex)', tone: 1, name: 'Sắc' },
      'f': { table: 'B1 (Telex)', tone: 2, name: 'Huyền' },
      'r': { table: 'B1 (Telex)', tone: 3, name: 'Hỏi' },
      'x': { table: 'B1 (Telex)', tone: 4, name: 'Ngã' },
      'j': { table: 'B1 (Telex)', tone: 5, name: 'Nặng' },

      'y': { table: 'B2 (yaeiou)', tone: 0, name: 'Bằng' },
      'a': { table: 'B2 (yaeiou)', tone: 1, name: 'Sắc' },
      'e': { table: 'B2 (yaeiou)', tone: 2, name: 'Huyền' },
      'i': { table: 'B2 (yaeiou)', tone: 3, name: 'Hỏi' },
      'o': { table: 'B2 (yaeiou)', tone: 4, name: 'Ngã' },
      'u': { table: 'B2 (yaeiou)', tone: 5, name: 'Nặng' },

      '0': { table: 'B3 (Số VNI)', tone: 0, name: 'Bằng' },
      '1': { table: 'B3 (Số VNI)', tone: 1, name: 'Sắc' },
      '2': { table: 'B3 (Số VNI)', tone: 2, name: 'Huyền' },
      '3': { table: 'B3 (Số VNI)', tone: 3, name: 'Hỏi' },
      '4': { table: 'B3 (Số VNI)', tone: 4, name: 'Ngã' },
      '5': { table: 'B3 (Số VNI)', tone: 5, name: 'Nặng' }
    };

    // 2. DATA 11 PHỤ ÂM GHÉP
    const CONS_CLUSTERS = {
      'th': { key: 't', b60: 'T (hoa)', name: 'Th' },
      'tr': { key: 'r', b60: 'R (hoa)', name: 'Tr' },
      'ch': { key: 'c', b60: 'C (hoa)', name: 'Ch' },
      'kh': { key: 'k', b60: 'K (hoa)', name: 'Kh' },
      'gh': { key: 'g', b60: 'G (hoa)', name: 'Gh' },
      'ng': { key: 'n', b60: 'N (hoa)', name: 'Ng' },
      'nh': { key: 'h', b60: 'H (hoa)', name: 'Nh' },
      'ph': { key: 'p', b60: 'f (thường)', name: 'Ph' },
      'qu': { key: 'q', b60: 'q (thường)', name: 'Qu' },
      'gi': { key: 'g', b60: 'j (thường)', name: 'gi' },
      'đ':  { key: 'd', b60: 'd (thường)', name: 'đ' }
    };

    // 3. TOÀN BỘ CẤU HÌNH 8 HƯỚNG BÀN PHÍM LƯỚI (TỪ KEYBOARD-GRID.HTML)
    const KEY_NEIGHBORS = {
      't': {
